# AgriSys Environment Configuration Blueprint (.env.example)
# Copy this file to .env and fill in your keys: cp .env.example .env

# === ENVIRONMENT MODE ===
ENVIRONMENT=development
LOG_LEVEL=INFO

# === LLM & AI PROVIDER KEYS ===
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=gsk_your_groq_key_here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OLLAMA_BASE_URL=http://localhost:11434
TAVILY_API_KEY=tvly-your-tavily-key-here

# === VECTOR STORE (QDRANT) ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# === DATABASE & CACHE ===
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=agrisys_user
POSTGRES_PASSWORD=agrisys_secure_password
POSTGRES_DB=agrisys_db
DATABASE_URL=postgresql://agrisys_user:agrisys_secure_password@localhost:5432/agrisys_db

# === OBJECT STORAGE (MINIO / S3) ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=agrisys_minio_admin
MINIO_SECRET_KEY=agrisys_minio_secret
MINIO_BUCKET_NAME=agrisys-media
MINIO_USE_SSL=false

# === LANGFUSE OBSERVABILITY ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=random_hex_secret_min_32_chars
LANGFUSE_SALT=random_salt_for_langfuse

# === EXTERNAL APIS (STAGES 4 - 7) ===
IMD_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
KCC_WEBHOOK_URL=https://kcc.icar.gov.in/api/v1/escalations
